{
  "hooks": {
    "PostToolUse": [],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/.agentloop/hooks/scope-check.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/verify.sh"
          },
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/.agentloop/hooks/on-stop.py"
          }
        ]
      }
    ]
  }
}
