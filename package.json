{
  "name": "agentloop",
  "version": "0.1.0",
  "description": "Autonomous AI coding orchestrator with enforced quality loops",
  "type": "module",
  "bin": {
    "agentloop": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "node ./scripts/jest-parallel.mjs",
    "lint": "eslint src/ --ext .ts",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "e2e": "bash scripts/e2e-real.sh"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.87",
    "@slack/webhook": "^7.0.0",
    "openai": "^4.0.0"
  },
  "overrides": {
    "axios": "1.14.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "typescript": "^5.4.5"
  }
}
